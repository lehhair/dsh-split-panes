+  // Re-resolve when the session roster changes: a pinned session may first
+  // appear (or vanish) after this component rendered — the parent tree can
+  // bail out on an unchanged children reference, so the scope subscribes to
+  // the roster itself (list snapshots are identity-stable between changes).
+  useSyncExternalStore(
+    (fn: () => void) => host.sessions.list.subscribe(fn),
+    () => host.sessions.list.getSnapshot(),
+  )
+  const info = sessionId === undefined ? host.sessions.emptyInfo : host.sessions.session(sessionId)
+  if (info === undefined) return null
+  // key={sessionId} remounts the subtree on a session switch, exactly like
+  // SessionProvider — a pane's component-local state must never leak across
+  // the sessions it is bound to. The absent-id hero keeps the constant key.
+  return (
+    <BindingContext.Provider key={sessionId ?? 'none'} value={info}>
+      {children}
+    </BindingContext.Provider>
+  )
+}
