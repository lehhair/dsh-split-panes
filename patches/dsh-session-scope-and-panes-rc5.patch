diff --git a/packages/client/web-react/tests/session-scope.client.spec.tsx b/packages/client/web-react/tests/session-scope.client.spec.tsx
new file mode 100644
index 0000000000..3d868684ec
--- /dev/null
+++ b/packages/client/web-react/tests/session-scope.client.spec.tsx
@@ -0,0 +1,179 @@
+// @vitest-environment jsdom
+/**
+ * SessionScope behavior account (explicit-id per-session render scope):
+ * binds a subtree to an arbitrary session's provide bundle while the global
+ * selection moves independently, renders the static no-session roster under
+ * an absent id, and stays empty until a pinned session materializes. The
+ * by-id seats (useSessionById / useProjectionById) ride the same host
+ * resolution — asserted through observable behavior, never through the
+ * internal BindingContext.
+ */
+import { useEffect } from 'react'
+import { describe, expect, it } from 'vitest'
+import { act, render } from '@testing-library/react'
+import type { SessionMaybeProvideInfo, StoredEntry } from '@deepseek-ai/dsh-client-ui-slots'
+import type { SessionId } from '@deepseek-ai/dsh-client-connection/client'
+import {
+  createSlotRenderer, SessionScope,
+  type SessionProvideInfo, type SlotRendererHost,
+} from '@deepseek-ai/dsh-client-web-react'
+
+function observable<T>(initial: T) {
+  let value = initial
+  const subs = new Set<() => void>()
+  return {
+    getSnapshot: () => value,
+    subscribe: (fn: () => void) => { subs.add(fn); return () => { subs.delete(fn) } },
+    set: (next: T) => { value = next; for (const fn of [...subs]) fn() },
+  }
+}
+
+/**
+ * Minimal host with the by-id seam: `sessions.session(id)` resolves per-id
+ * bundles and `sessions.emptyInfo` is the fixed no-session roster, exactly
+ * the members the production SlotRegistry host face supplies.
+ */
+function makeHost(bodies: { root: (renderSlot: (key: string, owner: object) => React.ReactNode) => React.ReactNode }) {
+  const absentInfo: SessionMaybeProvideInfo = { sessionId: undefined, hooks: { session: undefined }, props: {} }
+  const list = observable<unknown>({ ids: [] as string[] })
+  const infos = new Map<string, SessionProvideInfo>()
+  const sessionEntries: StoredEntry[] = []
+  const rootEntry: StoredEntry = {
+    component: (props: { renderSlot: (key: string, owner: object) => React.ReactNode }) =>
+      <>{bodies.root(props.renderSlot)}</>,
+    options: {},
+    children: { 'k.session': { kind: 'single', scope: 'session' } },
+  }
+  const host: SlotRendererHost = {
+    subscribe: () => () => {},
+    getVersion: () => 0,
+    entriesOf: key => key === 'root' ? [rootEntry] : sessionEntries,
+    entriesOfSlot: key => key === 'root' ? [rootEntry] : sessionEntries,
+    reportEntryError: () => {},
+    specOf: key => key === 'k.session' ? { kind: 'single', scope: 'session' } : undefined,
+    isLive: () => true,
+    storeOf: () => undefined,
+    sessions: {
+      list,
+      provideInfo: observable<SessionMaybeProvideInfo>(absentInfo),
+      session: id => infos.get(id),
+      emptyInfo: absentInfo,
+    },
+    workspaces: { list: observable<unknown>({ items: [] }) },
+  }
+  return {
+    host,
+    addSession: (id: string) => {
+      const info: SessionProvideInfo = {
+        sessionId: id as SessionId,
+        hooks: { session: { getSnapshot: () => ({ sid: id }), subscribe: () => () => {} } },
+        props: {},
+      }
+      infos.set(id, info)
+      list.set({ ids: [...infos.keys()] })
+      return info
+    },
+    registerSession: (entry: StoredEntry) => { sessionEntries.push(entry) },
+  }
+}
+
+describe('SessionScope', () => {
+  it('binds the subtree to the pinned session bundle regardless of the global selection', () => {
+    const seen: string[] = []
+    const h = makeHost({
+      root: renderSlot => (
+        <SessionScope sessionId={'s1' as SessionId}>
+          {renderSlot('k.session', {})}
+        </SessionScope>
+      ),
+    })
+    h.addSession('s1')
+    h.addSession('s2')
+    h.addSession('s3')
+    h.registerSession({
+      component: (props: { useSession?: <S>(sel: (s: { sid: string }) => S) => S; sessionId?: string }) => {
+        seen.push(`${props.sessionId}:${props.useSession!(s => s.sid)}`)
+        return null
+      },
+      options: {},
+    })
+    render(<>{createSlotRenderer().renderRoot(h.host, {})}</>)
+    // The scope's own bundle (s1), not the current selection (undefined).
+    expect(seen.at(-1)).toBe('s1:s1')
+  })
+
+  it('renders the static no-session roster when the pinned id is absent (hero branch)', () => {
+    const seen: unknown[] = []
+    const h = makeHost({
+      root: renderSlot => (
+        <SessionScope sessionId={undefined}>
+          {renderSlot('k.session', {})}
+        </SessionScope>
+      ),
+    })
+    h.addSession('s1')
+    h.registerSession({
+      component: (props: { useSession?: <S>(sel: (s: { sid: string }) => S) => S; sessionId?: string }) => {
+        seen.push(props.sessionId)
+        return null
+      },
+      options: {},
+    })
+    render(<>{createSlotRenderer().renderRoot(h.host, {})}</>)
+    // The absent branch renders nothing (no definite session to mount).
+    expect(seen).toEqual([])
+  })
+
+  it('stays empty until a pinned session materializes on the roster', () => {
+    const seen: string[] = []
+    const h = makeHost({
+      root: renderSlot => (
+        <SessionScope sessionId={'late' as SessionId}>
+          {renderSlot('k.session', {})}
+        </SessionScope>
+      ),
+    })
+    h.registerSession({
+      component: (props: { useSession?: <S>(sel: (s: { sid: string }) => S) => S; sessionId?: string }) => {
+        seen.push(`${props.sessionId}:${props.useSession!(s => s.sid)}`)
+        return null
+      },
+      options: {},
+    })
+    const view = render(<>{createSlotRenderer().renderRoot(h.host, {})}</>)
+    expect(seen).toEqual([])
+    // The session appears later: the scope re-resolves off the roster change.
+    act(() => { h.addSession('late') })
+    expect(seen.at(-1)).toBe('late:late')
+    void view
+  })
+
+  it('remounts the subtree when the pinned session switches (key semantics, like SessionProvider)', () => {
+    let mounts = 0
+    function Body({ id }: { id: string }) {
+      useEffect(() => { mounts += 1 }, [])
+      return <div data-testid="body">{id}</div>
+    }
+    let pinned = 's1' as SessionId
+    const h = makeHost({
+      root: renderSlot => (
+        <SessionScope sessionId={pinned}>
+          {renderSlot('k.session', {})}
+        </SessionScope>
+      ),
+    })
+    h.addSession('s1')
+    h.addSession('s2')
+    h.registerSession({
+      component: (props: { sessionId?: string }) => <Body id={props.sessionId ?? ''} />,
+      options: {},
+    })
+    const view = render(<>{createSlotRenderer().renderRoot(h.host, {})}</>)
+    expect(mounts).toBe(1)
+    // Switching the pinned session remounts the subtree — component-local
+    // state never leaks across the sessions a pane is bound to.
+    pinned = 's2' as SessionId
+    act(() => { view.rerender(<>{createSlotRenderer().renderRoot(h.host, {})}</>) })
+    expect(mounts).toBe(2)
+  })
+})
